# Usuario público de Last.fm del que se leerán los scrobbles.
LASTFM_USERNAME=

# API Key de Last.fm creada en https://www.last.fm/api/account/create
# No es el "Shared secret".
LASTFM_API_KEY=

# Shared Secret de Last.fm. Opcional por ahora; se reserva para futuras funciones autenticadas.
LASTFM_API_SECRET=

# Puerto HTTP expuesto por la app.
PORT=3001

# Rutas internas del contenedor. En Docker/Umbrel normalmente no hay que cambiarlas.
DATABASE_PATH=/app/data/music-stats.sqlite
IMAGE_CACHE_DIR=/app/data/image-cache
FRONTEND_DIST_PATH=/app/frontend/dist

# Frecuencia de sincronización automática.
SYNC_INTERVAL_MINUTES=30

# Last.fm no siempre entrega duración en recent tracks; este valor se usa como estimación.
DEFAULT_TRACK_DURATION_SECONDS=180
